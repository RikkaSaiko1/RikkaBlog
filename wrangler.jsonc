{
	"$schema": "https://raw.githubusercontent.com/cloudflare/wrangler/main/config-schema.json",
	"name": "rikkablog",
	"main": "src/index.ts",
	"compatibility_date": "2024-07-29",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist/client"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "nekro-edge-db-local",
			"database_id": "local",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "rikka-blog-images"
		}
	],
	"vars": {
		"NODE_ENV": "development",
		"VITE_PORT": "5173"
		// APP_BASE_URL 等环境相关值请通过 .dev.vars（本地）/ Secrets 或 dashboard 变量（线上）配置，勿写死在此
	},
	"env": {
		"production": {
			"name": "rikkablog",
			"assets": {
				"binding": "ASSETS",
				"directory": "./dist/client"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "rikka-blog-db",
					"database_id": "00c7c644-033f-48b7-a026-866902d208e3",
					"migrations_dir": "drizzle"
				}
			],
			"r2_buckets": [
				{
					"binding": "IMAGES",
					"bucket_name": "rikka-blog-images"
				}
			],
			"vars": {
				"NODE_ENV": "production",
				"VITE_PORT": "5173"
				// APP_BASE_URL 请在线上 Worker 的 Settings → Variables and Secrets 中配置（建议设为 Secret，deploy 不会被覆盖）
			}
		}
	},
	"observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1
    }
  }
}
