# 本地开发环境变量配置示例
# 复制此文件为 .dev.vars（项目根目录，已被 .gitignore 忽略）并填入实际值。
# 线上环境请勿使用本文件：在 Cloudflare dashboard 的 Worker → Settings → Variables and Secrets 中配置，
# 或使用 `wrangler secret put <KEY> --env production` 命令设置（Secret 不会被后续 deploy 覆盖）。

# GitHub OAuth App Configuration
# Create a new OAuth App at: https://github.com/settings/applications/new
# For local development:
#   - Application name: NekroEdge Template (Local)
#   - Homepage URL: http://localhost:8787
#   - Authorization callback URL: http://localhost:8787/auth/callback
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Application base URL（OAuth 回调与 CORS 允许来源依赖此值）
# Local development
APP_BASE_URL=http://localhost:8787
# Production example: https://your-domain.com

# Cloudflare 用量监控（可选，仅后台 SYSTEM STATUS 面板使用；Token 只需 Account Analytics Read 权限）
CF_ACCOUNT_ID=your_cloudflare_account_id_here
CF_API_TOKEN=your_cloudflare_api_token_here

# 和风天气 API Key（可选，天气接口使用）
QWEATHER_KEY=your_qweather_key_here

# AI 配置已迁移到后台「站点配置」页面。
